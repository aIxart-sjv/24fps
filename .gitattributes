# Enforce LF endings on shell scripts and Docker files to prevent CRLF execution issues in Linux containers
* text=auto

*.sh text eol=lf
*.bash text eol=lf
Dockerfile* text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.md text eol=lf

# Windows batch scripts retain CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
